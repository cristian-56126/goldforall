# Dependencias estrictas: un paquete solo puede importar lo que declara.
# Evita "funciona en mi máquina" por dependencias fantasma.
hoist=false
strict-peer-dependencies=false

# Bloquea scripts de instalación arbitrarios de dependencias transitivas.
# Si un paquete legítimo los necesita, se agrega a onlyBuiltDependencies.
enable-pre-post-scripts=false

# Fallar si el lockfile no coincide con los package.json (CI-safe por defecto).
prefer-frozen-lockfile=true
