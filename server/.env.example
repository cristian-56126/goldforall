# Copiar a .env y completar. NUNCA commitear .env (ya está en .gitignore).

NODE_ENV=development
PORT=4310

# URLs públicas. APP_URL = frontend (enlaces de correo, redirección OAuth).
# API_URL = esta API (se usa para construir el redirect_uri de Google).
APP_URL=http://localhost:5310
API_URL=http://localhost:4310

# ---------------------------------------------------------------------------
# Secretos
# ---------------------------------------------------------------------------
# OBLIGATORIO. Mínimo 32 caracteres. Genéralo con:  pnpm secret
# Si falta o es un valor de plantilla, el servidor NO arranca.
JWT_SECRET=

# ---------------------------------------------------------------------------
# Sesión
# ---------------------------------------------------------------------------
# El access token vive en cookie httpOnly y dura poco; el refresh token rota
# en cada uso y se guarda hasheado en la base de datos.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
BCRYPT_ROUNDS=12

# Orígenes permitidos por CORS, separados por coma. En producción es
# obligatorio declararlos y no se acepta "*".
CORS_ORIGINS=http://localhost:5310

# Cookies. COOKIE_SECURE se activa solo en producción si no se declara.
# COOKIE_DOMAIN=.goldforall.com
# COOKIE_SECURE=true

# Saltos de proxy de confianza (Nginx / Railway / Render = 1). 0 = sin proxy.
# Necesario para que el rate limit vea la IP real del cliente.
TRUST_PROXY=0

# Correos que se promueven a rol admin al correr la migración (separados por coma).
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Proveedor gestionado (Neon, Render, Railway, Supabase): una sola URL.
# Si está presente, manda sobre las variables PG* de abajo.
# La URL se descompone en campos explícitos, así que un Postgres local en un
# puerto no estándar no puede colarse en la conexión remota.
# DATABASE_URL=postgresql://usuario:clave@host/basededatos?sslmode=require

# Postgres local (se ignora si hay DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=goldforall
# false = sin TLS (local) | true = TLS verificado | no-verify = TLS sin validar CA
PGSSL=false

# ---------------------------------------------------------------------------
# APIs externas (gratis, sin API key por defecto)
# ---------------------------------------------------------------------------
GOLD_API_URL=https://api.gold-api.com/price/XAU
RATES_API_URL=https://open.er-api.com/v6/latest/USD

# Cache de precios en segundos (oro corto = frescura máxima;
# tasas: el proveedor gratis actualiza 1 vez al día)
GOLD_CACHE_SECONDS=10
RATES_CACHE_SECONDS=600

# Muestreo de históricos (ventana 12 h) en segundos
HISTORY_SAMPLE_SECONDS=300

# Zona horaria que define cuándo se reinicia el día para la cuota del plan gratis
QUOTA_TIMEZONE=America/Bogota

# ---------------------------------------------------------------------------
# Google OAuth (opcional)
# ---------------------------------------------------------------------------
# Crear en https://console.cloud.google.com/apis/credentials
#   Tipo: "ID de cliente de OAuth" -> "Aplicación web"
#   URI de redirección autorizado: http://localhost:4310/api/auth/google/callback
# Si estas dos variables faltan, el login con Google queda desactivado
# y el frontend oculta el botón automáticamente.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Solo si el callback no vive en API_URL + /api/auth/google/callback
# GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# SMTP para recuperación de contraseña (opcional)
# ---------------------------------------------------------------------------
# Sin SMTP_HOST, el enlace de recuperación se imprime en la consola del
# servidor (suficiente para desarrollo local).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=GoldForAll <no-reply@goldforall.local>
